#!/usr/bin/env python3
"""Fetch usage limits and credits from LLM providers into one JSON file.

Writes ~/.cache/llm-usage.json and prints the same JSON to stdout.
Exits 1 if any provider failed; that provider keeps its last successful data
(with its own fetched_at) and gets status "error" and the error message.
"""

import json
import subprocess
import sys
import time
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

OUT = Path.home() / ".cache" / "llm-usage.json"
TIMEOUT = 15


def http_json(url, headers):
	req = urllib.request.Request(url, headers=headers)
	with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
		return json.load(resp)


def run(cmd, cwd=None):
	return subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, check=True, timeout=TIMEOUT).stdout


def anthropic():
	# Reuses Claude Code's OAuth login. We never refresh the token ourselves:
	# refreshing rotates it and would log Claude Code out.
	creds = json.loads(run(["security", "find-generic-password", "-s", "Claude Code-credentials", "-w"]))["claudeAiOauth"]
	if creds["expiresAt"] / 1000 < time.time():
		raise RuntimeError("Claude Code OAuth token expired; run `claude` once to refresh it")
	d = http_json("https://api.anthropic.com/api/oauth/usage", {
		"Authorization": f"Bearer {creds['accessToken']}",
		"anthropic-beta": "oauth-2025-04-20",
	})
	limits = [
		{"name": l["kind"] + (f" ({l['scope']['model']['display_name']})" if l.get("scope") else ""),
		 "used_pct": l["percent"], "resets_at": l["resets_at"]}
		for l in d["limits"]
	]
	# Credit grants show up as top-level entries that carry a dollar limit.
	credits = [
		{"name": k, "remaining_usd": round(v["remaining_dollars"], 2), "limit_usd": v["limit_dollars"],
		 "resets_at": v["resets_at"]}
		for k, v in d.items()
		if isinstance(v, dict) and v.get("limit_dollars") is not None
	]
	return {"plan": creds["subscriptionType"], "limits": limits, "credits": credits,
			"dashboard_url": "https://claude.ai/settings/usage"}


def copilot():
	d = json.loads(run(["gh", "api", "/copilot_internal/user"]))
	limits = [
		{"name": name, "used_pct": round(100 - q["percent_remaining"], 1),
		 "used": q["entitlement"] - q["remaining"], "entitlement": q["entitlement"],
		 "resets_at": d["quota_reset_date_utc"]}
		for name, q in d["quota_snapshots"].items()
		if not q["unlimited"]
	]
	return {"plan": d["copilot_plan"], "limits": limits, "credits": [],
			"dashboard_url": "https://github.com/settings/copilot/features"}


def deepinfra():
	# llm-key.sh hands out personal keys only when run from under ~/labs.
	key = run([str(Path.home() / "lawn/bin/llm-key.sh"), "DEEPINFRA_API_KEY"], cwd=Path.home() / "labs").strip()
	if not key:
		raise RuntimeError("llm-key.sh returned no DEEPINFRA_API_KEY")
	d = http_json("https://api.deepinfra.com/payment/checklist", {"Authorization": f"Bearer {key}"})
	# A negative Stripe balance is credit in the account's favour.
	return {"plan": d["billing_type"], "limits": [],
			"credits": [{"name": "balance", "remaining_usd": -d["stripe_balance"], "limit_usd": None, "resets_at": None}],
			"suspended": d["suspended"], "dashboard_url": "https://deepinfra.com/dash/billing"}


PROVIDERS = {"anthropic": anthropic, "copilot": copilot, "deepinfra": deepinfra}


def main():
	now = datetime.now(timezone.utc).isoformat(timespec="seconds")
	previous = json.loads(OUT.read_text())["providers"] if OUT.exists() else {}
	result = {"fetched_at": now, "providers": {}}
	failed = False
	for name, fetch in PROVIDERS.items():
		try:
			result["providers"][name] = {"status": "ok", "fetched_at": now, **fetch()}
		except Exception as e:
			failed = True
			# Keep the last successful data, marked with the error and when it was fetched.
			last_ok = {k: v for k, v in previous.get(name, {}).items() if k != "error"}
			result["providers"][name] = {**last_ok, "status": "error", "error": f"{type(e).__name__}: {e}"}

	OUT.parent.mkdir(parents=True, exist_ok=True)
	tmp = OUT.with_suffix(".tmp")
	tmp.write_text(json.dumps(result, indent=2) + "\n")
	tmp.replace(OUT)
	print(json.dumps(result, indent=2))
	sys.exit(1 if failed else 0)


if __name__ == "__main__":
	main()
